rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Fonction helper : utilisateur authentifié
    function isAuthenticated() {
      return request.auth != null;
    }

    // Fonction helper : vérifie le rôle dans le document utilisateur
    function hasRole(role) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // Collection des utilisateurs (pour les rôles)
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false; // écriture réservée au backend/admin
    }

    // Données de l'application (toutes les collections existantes)
    match /app_data/{document=**} {
      allow read: if isAuthenticated();
      allow write: if hasRole('BUREAU') || hasRole('ADMIN');
    }

    // Bloque tout accès autre par défaut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}